        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "utmconverter",
        "utm converter",
        "coordinate conversion",
        "utm to lat lon",
        "lat lon to utm",
        "geographic coordinates"
    ],
    "homepage": "https://apiverve.com/marketplace/utmconverter?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/utmconverter",
